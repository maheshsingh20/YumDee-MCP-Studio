{
  "name": "@yumdee/mcp-studio-inspector",
  "version": "0.1.0",
  "description": "Web UI debugger + session replay for MCP servers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-studio-inspect": "./dist/cli.js"
  },
  "scripts": {
    "dev": "concurrently \"tsc --watch\" \"vite\"",
    "build": "tsc && vite build",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest"
  },
  "dependencies": {
    "@yumdee/mcp-studio-core": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "concurrently": "^8.0.0"
  }
}
