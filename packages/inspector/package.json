{
  "name": "@yumdee/mcp-studio-inspector",
  "version": "0.2.0",
  "description": "Web UI debugger, session replay, and AI Root-Cause Diagnostic Copilot for Model Context Protocol (MCP) servers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-studio-inspector": "./dist/cli.js",
    "mcp-studio-inspect": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maheshsingh20/YumDee-MCP-Studio.git",
    "directory": "packages/inspector"
  },
  "author": "Mahesh Singh <maheshsingh20>",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "inspector",
    "debugger",
    "ai-diagnostics",
    "copilot",
    "agent",
    "sse"
  ],
  "scripts": {
    "dev": "concurrently \"tsc --watch\" \"vite\"",
    "build": "tsc && vite build",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@yumdee/mcp-studio-core": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "concurrently": "^8.0.0"
  }
}
